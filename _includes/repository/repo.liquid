<div class="repo p-2">
  <a href="{{ include.repository.url }}" target="_blank" class="repo-card-link">
    <div class="repo-card">
      <div class="repo-card-header">
        <span class="repo-card-title">
          {{ include.repository.name }}
        </span>
      <span class="repo-icon">
        {% if include.repository.platform == "github" %}
          <i class="fa-brands fa-github"></i>
        {% elsif include.repository.platform == "gitlab" %}
          <i class="fa-brands fa-gitlab"></i>
        {% elsif include.repository.platform == "codeberg" %}
          <i class="fa fa-code-branch"></i>
        {% endif %}
      </span>
     </div>

      <div class="repo-card-description">
        {{ include.repository.description }}
      </div>

      <div class="repo-card-footer">
        {% if include.repository.language %}
          <span class="repo-language-dot"></span>
          <span class="repo-language-name">
            {{ include.repository.language }}
          </span>
        {% endif %}
        {% if include.repository.stars %}
            <i class="fa-solid fa-star"></i>
          <span class="repo-language-name">
            {{ include.repository.stars }}
          </span>
        {% endif %}
        {% if include.repository.platform %}
            <span class="repo-icon">
              {% if include.repository.platform == "github" %}
                <i class="fa-brands fa-github"></i>
              {% elsif include.repository.platform == "gitlab" %}
                <i class="fa-brands fa-gitlab"></i>
              {% elsif include.repository.platform == "codeberg" %}
                <i class="fa fa-code-branch"></i>
              {% endif %}
            </span>
          <span class="repo-language-name">
            {{ include.repository.platform }}
          </span>
        {% endif %}
      </div>

    </div>
  </a>
</div>

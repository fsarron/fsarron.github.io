{% if include.repository.name %}

<div class="repo p-2 text-center">
  <a href="{{ include.repository.url }}" target="_blank" class="repo-link">
    <div class="gh-card">

      <div class="gh-card-header">
        <span class="gh-repo-icon">
          <i class="fas fa-book"></i>
        </span>
        <span class="gh-repo-name">
          {{ include.repository.name }}
        </span>
      </div>

      <div class="gh-card-description">
        {{ include.repository.description }}
      </div>

      <div class="gh-card-footer">
        {% if include.repository.language %}
          <span class="gh-lang-dot"></span>
          <span class="gh-lang-name">
            {{ include.repository.language }}
          </span>
        {% endif %}

        {% if include.repository.platform %}
          <span class="gh-platform">
            {% if include.repository.platform == "gitlab" %}
              <i class="fab fa-gitlab"></i>
            {% elsif include.repository.platform == "codeberg" %}
              <i class="fa fa-code-branch"></i>
            {% endif %}
          </span>
        {% endif %}
      </div>

    </div>
  </a>
</div>

{% else %}

  <!-- Original GitHub behavior -->

  {% assign repo_url = include.repository | split: '/' %}
  {% if site.data.repositories.github_users contains repo_url.first %}
    {% assign show_owner = false %}
  {% else %}
    {% assign show_owner = true %}
  {% endif %}

  <div class="repo p-2 text-center">
    <a href="https://github.com/{{ include.repository }}">
      <img
        class="repo-img-light w-100"
        alt="{{ include.repository }}"
        src="https://github-readme-stats.vercel.app/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&theme={{ site.repo_theme_light }}&show_owner={{ show_owner }}"
      >
      <img
        class="repo-img-dark w-100"
        alt="{{ include.repository }}"
        src="https://github-readme-stats.vercel.app/api/pin/?username={{ repo_url[0] }}&repo={{ repo_url[1] }}&theme={{ site.repo_theme_dark }}&show_owner={{ show_owner }}"
      >
    </a>
  </div>

{% endif %}
